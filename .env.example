# Copie para .env e ajuste. Nenhuma variável é obrigatória na Fase 01.

# PostgreSQL (opcional nesta fase — o app não acessa o banco ainda).
# DATABASE_URL="postgresql://usuario:senha@localhost:5432/astrologia?schema=public"

# URL pública usada em metadados (opcional).
# NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Geração com IA (Fase 02F) — somente servidor, nunca NEXT_PUBLIC_ ──
# Sem estas três variáveis, o app usa o provedor simulado (sem rede, sem custo).
# SIDERA_AI_ENABLED="1"
# SIDERA_AI_PROVIDER="anthropic"
# SIDERA_ANTHROPIC_API_KEY=""     # exclusiva do Sidera (ANTHROPIC_API_KEY é aceita como alternativa local)
# Opcionais (padrões: claude-haiku-5-5 e medium; Sonnet 5.5 segue suportado).
# SIDERA_AI_MODEL="claude-haiku-5-5"
# SIDERA_AI_EFFORT="medium"
# SIDERA_AI_REFUSAL_FALLBACK="1"   # liga o fallback pago do servidor entre modelos (padrão: desligado)
# Avaliação comparativa paga (paid-eval.test.ts) — só com autorização do proprietário.
# SIDERA_AI_PAID_TESTS="1"
# SIDERA_AI_PAID_SUITE="haiku-validation"  # validação só com Haiku 5.5 (não roda a comparação com Sonnet)

# Leitura das mãos: análise visual (Fase 03D). Tudo desligado por padrão.
# SIDERA_PALM_ANALYSIS_ENABLED="1"         # liga os endpoints internos (sem ela: 404); usa o SIMULADOR
# SIDERA_PALM_VISION_MOCK_SCENARIO="clear" # clear | partial | insufficient | lines-missing | contradictory | ...
# Chamada REAL ao provedor (exige todas, chave no servidor e NODE_ENV != production):
# SIDERA_PALM_VISION_PROVIDER="anthropic"
# SIDERA_PALM_VISION_REAL="1"
# SIDERA_PALM_VISION_MODEL="claude-haiku-5-5" # ou claude-sonnet-5-5 (separado de SIDERA_AI_MODEL)
# SIDERA_PALM_VISION_EFFORT="medium"
# SIDERA_PALM_VISION_BUDGET_USD="0.10"       # teto por processo; nunca acima de 1
# SIDERA_CONSENT_SECRET=""                   # ≥ 32 caracteres; obrigatório em produção (assina o recibo de consentimento)
# SIDERA_AI_KEY_VIA_PROXY="1"      # chave como segredo de rede da sessão (x-api-key)
# SIDERA_AI_EVAL_BUDGET_BRL="15"   # teto total; valores acima de 15 são ignorados
# SIDERA_AI_USD_BRL="5.5"          # câmbio para converter o teto
