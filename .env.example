# Copie para .env e ajuste. Nenhuma variável é obrigatória na Fase 01.

# PostgreSQL (opcional nesta fase — o app não acessa o banco ainda).
# DATABASE_URL="postgresql://usuario:senha@localhost:5432/astrologia?schema=public"

# URL pública usada em metadados (opcional).
# NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Geração com IA (Fase 02F) — somente servidor, nunca NEXT_PUBLIC_ ──
# Sem estas três variáveis, o app usa o provedor simulado (sem rede, sem custo).
# SIDERA_AI_ENABLED="1"
# SIDERA_AI_PROVIDER="anthropic"
# ANTHROPIC_API_KEY=""
# Opcionais (padrões: claude-sonnet-5-5 e medium).
# SIDERA_AI_MODEL="claude-sonnet-5-5"
# SIDERA_AI_EFFORT="medium"
# Autorização explícita para a avaliação paga (paid-eval.test.ts).
# SIDERA_AI_PAID_TESTS="1"
