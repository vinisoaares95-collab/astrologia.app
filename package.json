{
  "name": "cation-astrologia",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/with-tzdata.mjs next dev",
    "build": "node scripts/with-tzdata.mjs next build",
    "start": "node scripts/with-tzdata.mjs next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node scripts/with-tzdata.mjs vitest run",
    "test:watch": "node scripts/with-tzdata.mjs vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run test",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "postinstall": "prisma generate",
    "ephe:fetch": "node scripts/fetch-ephemeris.mjs",
    "pretest": "node scripts/fetch-ephemeris.mjs --if-missing",
    "tz:diff": "node scripts/tz/compare-tzdb.mjs"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "lucide-react": "^1.65.0",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "sweph": "2.10.3-8"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "astronomy-engine": "2.1.19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prisma": "^7.10.1",
    "tailwindcss": "^4",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=20.19"
  }
}
